---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
---

<Base>
  <main class="wrap flex min-h-[75vh] flex-col items-start justify-center py-20">
    <p class="text-sm font-semibold uppercase tracking-[0.2em] text-accent">404 · Page not found</p>
    <h1 class="display mt-4 text-[clamp(3.5rem,10vw,7rem)]">A quiet little detour.</h1>
    <p class="mt-5 max-w-lg text-lg text-muted">That page is not on the menu. Head back to {site.name} and find your seat.</p>
    <a href="/" class="btn btn-accent mt-8">Back to the homepage</a>
  </main>
</Base>
