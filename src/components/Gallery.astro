---
import { Image } from 'astro:assets';
import { availablePhotos } from '../lib/photos';

// Foto hero dipakai di bagian atas halaman; galeri memakai bar-1 sampai bar-6.
const items = availablePhotos().filter((p) => p.name !== 'hero');
const spans = [
  'md:col-span-7 aspect-[4/3]',
  'md:col-span-5 aspect-[4/3]',
  'md:col-span-4 aspect-square',
  'md:col-span-4 aspect-square',
  'md:col-span-4 aspect-square',
  'md:col-span-12 aspect-[21/9]',
];
---

{
  items.length > 0 && (
    <section aria-label="Photos" class="wrap pb-20 lg:pb-28">
      <div class="grid gap-3 md:grid-cols-12 md:gap-4">
        {items.slice(0, 6).map((p, i) => (
          <figure class={`m-0 overflow-hidden rounded-2xl bg-surface ${spans[i]}`}>
            <Image
              src={p.image}
              alt={p.alt}
              widths={[480, 800, 1200]}
              sizes="(min-width: 768px) 60vw, 100vw"
              format="webp"
              loading="lazy"
              class="h-full w-full object-cover"
            />
          </figure>
        ))}
      </div>
    </section>
  )
}
